# =========================
# BrigadIA – Backend ENV (example)
# Ne pas commit de secrets. Copier ce fichier en `.env` puis remplir les valeurs.
# =========================

# IMPORTANT: Les variables frontend restent dans le .env racine et DOIVENT être 
# préfixées par VITE_ (ex: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_BACKEND_URL)

# --- Supabase (backend uniquement) ---
# URL de l'instance Supabase (Project Settings > API)
SUPABASE_URL=

# Clé service role (Project Settings > API). NE JAMAIS exposer côté front.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Clé secrète Stripe (Dashboard > Developers > API Keys)
STRIPE_SECRET_KEY=

# Secret du webhook Stripe (Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=

# --- OpenAI ---
# Clé API OpenAI (platform.openai.com > API Keys)
OPENAI_API_KEY=

# ID de l'assistant OpenAI configuré pour l'analyse de factures
OPENAI_ASSISTANT_ID=

# --- Configuration serveur backend ---
# Port HTTP du serveur Express
PORT=3001

# Mode d'exécution (development|production)
NODE_ENV=development